rules_version = '2';

// Deny-by-default for everything except the explicit grants below.
// Every grant is role-scoped and owner-scoped. No `allow read, write: if true`.
// Sensitive fields (trust, points, idVerified, banned, etc.) are write-locked
// for clients and only mutated by Cloud Functions via Admin SDK.

service cloud.firestore {
  match /databases/{database}/documents {

    // ----- Helpers -----
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && 'isAdmin' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }
    function isSuspendedOrBanned(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path) && (
        ('accountStatus' in get(path).data.keys() && get(path).data.accountStatus == 'banned')
        || ('accountStatus' in get(path).data.keys() && get(path).data.accountStatus == 'suspended' && 'suspendedUntil' in get(path).data.keys() && get(path).data.suspendedUntil > request.time)
      );
    }
    function isVolunteer() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path)
        && 'roles' in get(path).data.keys()
        && get(path).data.roles.hasAny(['volunteer']);
    }

    // Fields a client may set on their initial users/{uid} document.
    function userCreateAllowedKeys() {
      return [
        'displayName',
        'photoURL',
        'bio',
        'phoneNumber',
        'email',
        'roles',
        'skills',
        'consent',
        'createdAt'
      ];
    }

    // Fields a client may mutate on their own users/{uid} document after create.
    // Consent + createdAt are write-once: enforced by exclusion from this list.
    function userUpdateAllowedKeys() {
      return [
        'displayName',
        'photoURL',
        'bio',
        'phoneNumber',
        'email',
        'roles',
        'skills',
        'idImagePath',
        'availableNow',
        'availabilityUpdatedAt',
        'lastKnownLocation',
        'freezeAcknowledgedAt'
      ];
    }

    // Server-only fields. Must never appear in a client write at create-time.
    // (Update-time enforcement comes from userUpdateAllowedKeys() being the
    // exhaustive allowlist of client-mutable fields.) Note: idImagePath is
    // client-writable on update (profile upload) but the trust gate is the
    // server-only `idVerified` boolean below.
    function userServerOnlyKeys() {
      return [
        'idVerified',
        'idVerificationStatus',
        'idVerificationSubmittedAt',
        'idVerificationReviewedAt',
        'idVerificationReviewedBy',
        'idVerificationRejectionReason',
        'idVerifiedAt',
        'trustScore',
        'verifiedTaskCount',
        'verifiedHours',
        'points',
        'skillPoints',
        'openReportsCount',
        'warningsCount',
        'suspendedUntil',
        'banned',
        'lastSeenAt',
        'isAdmin',
        'pendingReports',
        'accountStatus',
        'moderationReason',
        'frozenAt',
        'frozenReason',
        'warningStrikeCount'
      ];
    }


    // Consent shape: { tcVersion: string, acceptedAt: timestamp }.
    function hasValidConsent() {
      return request.resource.data.consent.tcVersion is string
        && request.resource.data.consent.acceptedAt is timestamp;
    }

    // Roles, if present, must be an array of allowed strings.
    function rolesIfPresentValid() {
      return !('roles' in request.resource.data.keys())
        || (request.resource.data.roles is list
            && request.resource.data.roles.size() > 0
            && request.resource.data.roles.size() <= 2
            && request.resource.data.roles.hasOnly(['volunteer', 'customer']));
    }

    // ----- tasks/{taskId} -----

    // Field whitelist for the initial client create. Lifecycle fields
    // (acceptedVolunteerId, startedAt, completedAt, OTP fields, ratings)
    // are added later by Cloud Functions / future client flows.
    function taskCreateAllowedKeys() {
      return [
        'customerId',
        'customerName',
        'customerPhotoURL',
        'title',
        'category',
        'requiredSkills',
        'description',
        'location',
        'riskLevel',
        'estimatedMinutes',
        'status',
        'searchRadiusM',
        'createdAt',
        'expiresAt',
        'expectedWaitTier',
        'waitStartedAt',
        'nextCheckAt',
        'scheduledFor',
        'scheduledCreatedAt'
      ];
    }




    function taskDescriptionValid() {
      let d = request.resource.data.description;
      return d.meetingPoint is string && d.meetingPoint.size() > 0
        && d.meetingPoint.size() <= 280
        && d.whatToBring is string
        && d.whatToBring.size() <= 280
        && (!('preference' in d.keys()) || (d.preference is string && d.preference.size() <= 280))
        && (!('safetyNote' in d.keys()) || (d.safetyNote is string && d.safetyNote.size() <= 280));
    }

    function taskLocationValid() {
      let l = request.resource.data.location;
      return l.lat is number && l.lat >= -90 && l.lat <= 90
        && l.lng is number && l.lng >= -180 && l.lng <= 180
        && l.h3Cell is string && l.h3Cell.size() > 0;
    }

    function taskFieldsValid() {
      let d = request.resource.data;
      return d.title is string && d.title.size() > 0 && d.title.size() <= 80
        && d.customerName is string && d.customerName.size() > 0 && d.customerName.size() <= 80
        && (!('customerPhotoURL' in d.keys()) || (d.customerPhotoURL is string))
        && d.category is string && d.category.size() > 0
        && d.requiredSkills is list && d.requiredSkills.size() > 0
        && d.requiredSkills.size() <= 5
        && d.riskLevel in ['low', 'medium']           // 'high' / 'prohibited' rejected here
        && d.estimatedMinutes is number
        && d.estimatedMinutes >= 5 && d.estimatedMinutes <= 480
        && d.searchRadiusM is number
        && d.searchRadiusM >= 500 && d.searchRadiusM <= 10000
        && d.createdAt is timestamp
        && taskDescriptionValid()
        && taskLocationValid()
        && (
          (d.status == 'searching' && d.expiresAt is timestamp)
          || (d.status == 'scheduled' && d.scheduledFor is timestamp)
        );
    }


    match /tasks/{taskId} {
      // Read access:
      //   - the task's customer always
      //   - the accepted volunteer (after they accept)
      //   - administrators
      //   - active, authenticated volunteers for open searching tasks
      // Restricted: suspended/banned users cannot read active task assignments.
      allow read: if isSignedIn() && (
        isAdmin() || (
          !isSuspendedOrBanned(request.auth.uid) && (
            request.auth.uid == resource.data.customerId
            || request.auth.uid == resource.data.acceptedVolunteerId
            || (resource.data.status == 'searching' && isVolunteer())
          )
        )
      );

      allow create: if isSignedIn()
        && !isSuspendedOrBanned(request.auth.uid)
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.keys().hasOnly(taskCreateAllowedKeys())
        && taskFieldsValid();

      // Lifecycle writes (accept, status changes, OTP material) live in
      // Cloud Functions (Admin SDK bypasses these rules). Clients have
      // no direct update path.
      allow update: if false;
      allow delete: if false;

      // Customer reading the offers subcollection of THEIR task.
      // Subcollection match (also covered by the wildcard rule below).
      match /offers/{volunteerId} {
        allow read: if isSignedIn()
          && !isSuspendedOrBanned(request.auth.uid)
          && request.auth.uid
             == get(/databases/$(database)/documents/tasks/$(taskId)).data.customerId;
        allow write: if false;
      }

      // Append-only audit trail. Cloud Functions write via Admin SDK
      // (bypasses these rules). Customer and accepted volunteer can read;
      // everyone else denied.
      match /events/{eventId} {
        allow read: if isSignedIn() && (
          isAdmin() || (
            !isSuspendedOrBanned(request.auth.uid) && (
              request.auth.uid
                == get(/databases/$(database)/documents/tasks/$(taskId)).data.customerId
              || ('acceptedVolunteerId' in get(/databases/$(database)/documents/tasks/$(taskId)).data.keys()
                  && request.auth.uid == get(/databases/$(database)/documents/tasks/$(taskId)).data.acceptedVolunteerId)
            )
          )
        );
        allow write: if false;
      }
    }

    // Volunteer reading their own offers via collection-group query.
    // The recursive {path=**} segment is REQUIRED for collection-group
    // queries to match the rule — nested matches only cover subcollection
    // access, not `collectionGroup('offers')`.
    match /{path=**}/offers/{volunteerId} {
      allow read: if isSignedIn()
        && resource.data.volunteerId == request.auth.uid;
      allow write: if false;
    }

    // ----- users/{userId} -----
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userCreateAllowedKeys())
        && hasValidConsent()
        && rolesIfPresentValid()
        && !request.resource.data.keys().hasAny(userServerOnlyKeys());

      allow update: if isOwner(userId)
        && !isSuspendedOrBanned(userId)
        && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(userUpdateAllowedKeys())
        && rolesIfPresentValid();

      allow delete: if false;
    }

    // ----- reports/{reportId} -----
    match /reports/{reportId} {
      allow read: if isSignedIn() && (
        resource.data.reporterUid == request.auth.uid
        || isAdmin()
      );
      allow create: if false; // Handled by Cloud Function
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ----- blocks/{blockId} -----
    match /blocks/{blockId} {
      allow read: if isSignedIn() && (
        resource.data.userA == request.auth.uid
        || resource.data.userB == request.auth.uid
      );
      allow write: if false; // Handled by Cloud Function
    }

    // ----- adminActions/{actionId} -----
    match /adminActions/{actionId} {
      allow read: if isSignedIn() && (
        resource.data.targetUid == request.auth.uid
        || isAdmin()
      );
      allow write: if false; // Handled by Cloud Function
    }

    // ----- users/{userId}/moderationLog/{logId} -----
    match /users/{userId}/moderationLog/{logId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Handled by Cloud Function
    }

    // ----- users/{userId}/violations/{violationId} -----
    match /users/{userId}/violations/{violationId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Handled by Cloud Function
    }


    // ----- activityLog/{entryId} -----
    // Append-only, admin-read site-wide audit feed. All writes go through
    // Cloud Functions (Admin SDK bypasses these rules); clients have no
    // direct write path. Non-admin users cannot read.
    match /activityLog/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ----- chats/{chatId} (chatId === taskId; opens on acceptance) -----
    // M7 in-app chat. Participant-only read/write. Messages are immutable
    // for clients (no update/delete) — system messages and the `reportedBy`
    // marker are written by Cloud Functions (Admin SDK bypasses these rules).
    // No new messages once either party has blocked the other.

    function chatParticipants(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // May the caller post a new message? Binds the chat doc once (one get)
    // and probes both orderings of the mutual-block doc id (blocks are keyed
    // `${min}_${max}` with sorted UIDs, which rules can't reproduce).
    function canPostMessage(chatId) {
      let parts = get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      return request.auth.uid in parts
        && !(exists(/databases/$(database)/documents/blocks/$(parts[0] + '_' + parts[1]))
             || exists(/databases/$(database)/documents/blocks/$(parts[1] + '_' + parts[0])));
    }

    // A participant of an accepted/in-progress/completed task may open its
    // chat. Participants must be exactly the task's customer + accepted
    // volunteer; chatId must equal the taskId.
    function validChatCreate(chatId) {
      let task = get(/databases/$(database)/documents/tasks/$(chatId)).data;
      return chatId == request.resource.data.taskId
        && 'acceptedVolunteerId' in task.keys()
        && task.status in ['accepted', 'in_progress', 'completed']
        && request.resource.data.participants
             .hasOnly([task.customerId, task.acceptedVolunteerId])
        && request.resource.data.participants
             .hasAll([task.customerId, task.acceptedVolunteerId])
        && request.auth.uid in request.resource.data.participants;
    }

    match /chats/{chatId} {
      allow read: if isSignedIn()
        && !isSuspendedOrBanned(request.auth.uid)
        && request.auth.uid in resource.data.participants;

      allow create: if isSignedIn()
        && !isSuspendedOrBanned(request.auth.uid)
        && request.resource.data.keys().hasOnly(
             ['taskId', 'participants', 'createdAt', 'lastMessageAt', 'lastMessagePreview'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessagePreview is string
        && validChatCreate(chatId);

      // Participants may only bump the inbox preview fields.
      allow update: if isSignedIn()
        && !isSuspendedOrBanned(request.auth.uid)
        && request.auth.uid in resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessageAt', 'lastMessagePreview'])
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.lastMessagePreview is string;

      allow delete: if false;

      match /messages/{msgId} {
        allow read: if isSignedIn()
          && !isSuspendedOrBanned(request.auth.uid)
          && request.auth.uid in chatParticipants(chatId);

        allow create: if isSignedIn()
          && !isSuspendedOrBanned(request.auth.uid)
          && request.resource.data.keys().hasOnly(['senderUid', 'text', 'sentAt', 'system'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.system == false
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sentAt is timestamp
          && canPostMessage(chatId);

        // Immutable for clients. reportedBy + system messages are server-only.
        allow update, delete: if false;
      }
    }

    // ----- user_trails/{userId} (TrailService datastore) -----
    match /user_trails/{userId} {
      allow read, write: if isOwner(userId) && !isSuspendedOrBanned(userId);

      match /routes/{routeId} {
        allow read, write: if isOwner(userId) && !isSuspendedOrBanned(userId);
      }

      match /events/{eventId} {
        allow read, write: if isOwner(userId) && !isSuspendedOrBanned(userId);
      }
    }

    // Everything else stays deny-by-default until later milestones grant access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
